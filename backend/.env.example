# FinSight AI — backend environment template.
# Copy to `.env` for local dev. NEVER commit real secrets (see CONTRIBUTING.md).
# Every variable read by config/settings.py appears here — keep the two in sync.

# ----- Core app -----
APP_NAME="FinSight AI"
APP_ENV=development            # development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ----- Database (REQUIRED) -----
# Async SQLAlchemy URL using the asyncpg driver.
# Docker Compose:  postgresql+asyncpg://finsight:finsight@db:5432/finsight
# Local Postgres:  postgresql+asyncpg://finsight:finsight@localhost:5432/finsight
# Neon production: paste the direct (non-pooler) PostgreSQL URL with
# sslmode=require; settings normalize it for asyncpg. Never commit that value.
DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ----- Security (used from Phase 1) -----
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ----- Market data & external EOD runner -----
MARKET_FETCH_MAX_ATTEMPTS=3
MARKET_FETCH_TIMEOUT_SECONDS=30
MARKET_BOOTSTRAP_LOOKBACK_DAYS=370
MARKET_INCREMENTAL_OVERLAP_DAYS=7
MARKET_FULL_RECONCILIATION_DAYS=30
MARKET_PROVIDER_REPAIR_ENABLED=false
MARKET_TIMEZONE=Asia/Kolkata
MARKET_CALENDAR=NSE
MARKET_READINESS_SYMBOL=^NSEI
MARKET_CLOSE_GRACE_MINUTES=60
PIPELINE_HEARTBEAT_INTERVAL_SECONDS=30
PIPELINE_STALE_AFTER_SECONDS=900

# ----- Historical intelligence cache -----
DATA_DIR=./data
HISTORY_TOP_K=10

# ----- News and sentiment -----
SENTIMENT_BACKEND=lexicon
NEWS_MAX_ARTICLES_PER_FEED=50
NEWS_RECENT_WINDOW_DAYS=7
NEWS_RETAG_WINDOW_DAYS=30

# ----- AI / external providers (used from later phases) -----
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_THINKING_BUDGET=256
LLM_REQUEST_BUDGET_SECONDS=45
LLM_MAX_PROVIDER_CALLS=20
TOP_N_RECOMMENDATIONS=5
TRADING_ECONOMICS_API_KEY=
ECONOMIC_CALENDAR_TIMEOUT_SECONDS=10

# ----- CORS (comma-separated) -----
CORS_ORIGINS=http://localhost:3000
